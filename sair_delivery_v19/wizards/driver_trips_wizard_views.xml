<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sair_driver_trips_wizard_form" model="ir.ui.view">
        <field name="name">sair.driver.trips.wizard.form</field>
        <field name="model">sair.driver.trips.wizard</field>
        <field name="arch" type="xml">
            <form string="كشف رحلات السائقين">
                <sheet>
                    <div class="oe_title">
                        <h2>كشف رحلات السائقين</h2>
                    </div>
                    <group>
                        <group string="فلاتر السائقين">
                            <field name="driver_type"/>
                            <field name="partner_ids"
                                   widget="many2many_tags"
                                   placeholder="اختر سائق أو أكثر (اتركها فارغة للجميع)"/>
                        </group>
                        <group string="الفترة والحالة">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print" string="طباعة التقرير PDF" type="object" class="btn-primary" icon="fa-print"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_driver_trips_wizard" model="ir.actions.act_window">
        <field name="name">كشف رحلات السائقين</field>
        <field name="res_model">sair.driver.trips.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
